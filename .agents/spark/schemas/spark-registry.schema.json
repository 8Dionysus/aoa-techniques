{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aoa_techniques_spark_lane_registry_v1",
  "title": "aoa-techniques Spark lane registry",
  "type": "object",
  "required": [
    "schema_version",
    "authority_ref",
    "agents_ref",
    "notebook_ref",
    "swarm_ref",
    "storage_refs",
    "schema_refs",
    "scenarios",
    "validation_commands"
  ],
  "properties": {
    "schema_version": {
      "const": "aoa_techniques_spark_lane_registry_v1"
    },
    "authority_ref": {
      "const": ".agents/spark/README.md"
    },
    "agents_ref": {
      "const": ".agents/spark/AGENTS.md"
    },
    "notebook_ref": {
      "const": ".agents/spark/SPARK_EXTRAPOLATION_NOTEBOOK.md"
    },
    "swarm_ref": {
      "const": ".agents/spark/SWARM.md"
    },
    "storage_refs": {
      "type": "object",
      "required": [
        "handoffs",
        "handoffs_open",
        "handoffs_closed",
        "results"
      ],
      "properties": {
        "handoffs": {
          "type": "string"
        },
        "handoffs_open": {
          "type": "string"
        },
        "handoffs_closed": {
          "type": "string"
        },
        "results": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "schema_refs": {
      "type": "object",
      "required": [
        "registry",
        "result",
        "handoff"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "handoff": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "role",
          "path",
          "prompt_ref",
          "result_template_ref",
          "handoff_template_ref",
          "result_example_ref",
          "default_validation",
          "done_signal",
          "stop_line"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^\\.agents/spark/scenarios/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "prompt_ref": {
            "type": "string"
          },
          "result_template_ref": {
            "type": "string"
          },
          "handoff_template_ref": {
            "type": "string"
          },
          "result_example_ref": {
            "type": "string"
          },
          "default_validation": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "done_signal": {
            "type": "string",
            "minLength": 1
          },
          "stop_line": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "validation_commands": {
      "$ref": "#/$defs/non_empty_string_array"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$id": "https://github.com/8Dionysus/aoa-techniques/mechanics/distillation/parts/cross-layer-candidate-ledger/schemas/cross-layer-candidate-registry-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atom_topology_gate": {
      "additionalProperties": false,
      "properties": {
        "atomic_move_note": {
          "minLength": 1,
          "type": "string"
        },
        "atomic_move_status": {
          "enum": [
            "inherited",
            "landed",
            "not_named"
          ],
          "type": "string"
        },
        "capability_class": {
          "minLength": 1,
          "type": "string"
        },
        "execution_profile": {
          "minLength": 1,
          "type": "string"
        },
        "family_posture": {
          "minLength": 1,
          "type": "string"
        },
        "likely_domain": {
          "minLength": 1,
          "type": "string"
        },
        "portability_note": {
          "minLength": 1,
          "type": "string"
        },
        "primary_kind": {
          "minLength": 1,
          "type": "string"
        },
        "risk_posture": {
          "minLength": 1,
          "type": "string"
        },
        "substrate": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "atomic_move_status",
        "atomic_move_note",
        "likely_domain",
        "primary_kind",
        "family_posture",
        "capability_class",
        "substrate",
        "execution_profile",
        "risk_posture",
        "portability_note"
      ],
      "type": "object"
    },
    "candidate": {
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "current_gate": {
      "minLength": 1,
      "type": "string"
    },
    "gate_status": {
      "enum": [
        "inherited_external",
        "landed",
        "overlap_hold",
        "layer_incubation",
        "not_technique_shaped"
      ],
      "type": "string"
    },
    "inherited_external_status": {
      "minLength": 1,
      "type": "string"
    },
    "landed_technique": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^AOA-T-[0-9]{4}$",
          "type": "string"
        },
        "path": {
          "pattern": "^techniques/.+/TECHNIQUE.md$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "domain"
      ],
      "type": "object"
    },
    "law_local_bridge": {
      "additionalProperties": false,
      "properties": {
        "bridge_stop_line": {
          "minLength": 1,
          "type": "string"
        },
        "higher_law": {
          "minLength": 1,
          "type": "string"
        },
        "local_route": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "higher_law",
        "local_route",
        "bridge_stop_line"
      ],
      "type": "object"
    },
    "ledger_status": {
      "enum": [
        "already_staged_elsewhere",
        "landed_from_wave_map",
        "hold_because_overlap",
        "needs_layer_incubation_before_distillation_here",
        "substrate_or_architecture_pattern_not_yet_technique"
      ],
      "type": "string"
    },
    "nearest_overlap": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "next_move": {
      "minLength": 1,
      "type": "string"
    },
    "source_layer": {
      "minLength": 1,
      "type": "string"
    },
    "tentative_domain": {
      "minLength": 1,
      "type": "string"
    },
    "wave": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "source_layer",
    "tentative_domain",
    "ledger_status",
    "gate_status",
    "current_gate",
    "atom_topology_gate",
    "law_local_bridge",
    "nearest_overlap",
    "next_move"
  ],
  "title": "Distillation cross-layer candidate registry entry",
  "type": "object"
}
